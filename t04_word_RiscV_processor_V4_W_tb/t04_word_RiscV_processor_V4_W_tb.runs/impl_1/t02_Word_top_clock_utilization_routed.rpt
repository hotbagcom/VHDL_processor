# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y4 [get_cells n_1_164_BUFG_inst]
set_property LOC BUFGCTRL_X0Y2 [get_cells n_0_1588_BUFG_inst]
set_property LOC BUFGCTRL_X0Y3 [get_cells S_RST_BUFG_inst]
set_property LOC BUFGCTRL_X0Y1 [get_cells S_CLK_BUFG_inst]
set_property LOC BUFGCTRL_X0Y0 [get_cells CLK_top_IBUF_BUFG_inst]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X1Y26 [get_ports CLK_top]

# Clock net "n_1_164_BUFG" driven by instance "n_1_164_BUFG_inst" located at site "BUFGCTRL_X0Y4"
#startgroup
create_pblock {CLKAG_n_1_164_BUFG}
add_cells_to_pblock [get_pblocks  {CLKAG_n_1_164_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="n_1_164_BUFG"}]]]
resize_pblock [get_pblocks {CLKAG_n_1_164_BUFG}] -add {CLOCKREGION_X1Y0:CLOCKREGION_X1Y0}
#endgroup

